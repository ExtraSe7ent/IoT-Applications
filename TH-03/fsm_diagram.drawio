<mxfile host="app.diagrams.net"><diagram id="th03-fsm" name="TH03 FSM"><mxGraphModel pageWidth="1500" pageHeight="960" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TH03 — Máy trạng thái điều khiển LED nhà kính" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=35;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="1360" height="65" as="geometry" /></mxCell><mxCell id="stop" value="DỪNG&lt;br&gt;&lt;br&gt;PWM = 0 • tải tắt&lt;br&gt;Trạng thái an toàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#225c99;strokeWidth=3;fontSize=23;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="280" width="390" height="170" as="geometry" /></mxCell><mxCell id="run" value="CHẠY&lt;br&gt;&lt;br&gt;PWM 25% / 50% / 90%&lt;br&gt;Tối đa 15 giây / lần bật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf8f0;strokeColor=#277148;strokeWidth=3;fontSize=23;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1020" y="280" width="390" height="170" as="geometry" /></mxCell><mxCell id="fault" value="LỖI&lt;br&gt;&lt;br&gt;Tắt tải trước khi ghi log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1ef;strokeColor=#ad3a30;strokeWidth=3;fontSize=23;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1020" y="650" width="390" height="140" as="geometry" /></mxCell><mxCell id="initial" style="ellipse;html=1;fillColor=#23364b;strokeColor=#23364b;" vertex="1" parent="1"><mxGeometry x="270" y="155" width="30" height="30" as="geometry" /></mxCell><mxCell id="boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#304b63;" edge="1" parent="1" source="initial" target="stop"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="185" as="sourcePoint" /><mxPoint x="285" y="280" as="targetPoint" /></mxGeometry></mxCell><mxCell id="boot-label" value="Khởi động" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="220" height="65" as="geometry" /></mxCell><mxCell id="on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#304b63;" edge="1" parent="1" source="stop" target="run"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="315" as="sourcePoint" /><mxPoint x="1020" y="315" as="targetPoint" /></mxGeometry></mxCell><mxCell id="on-label" value="ON + cảm biến hợp lệ, còn mới&lt;br&gt;Khởi tạo OK và không bị khóa" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="495" y="220" width="510" height="80" as="geometry" /></mxCell><mxCell id="off" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#304b63;" edge="1" parent="1" source="run" target="stop"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="410" as="sourcePoint" /><mxPoint x="480" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="off-label" value="OFF hoặc đủ 15 giây → tắt tải&lt;br&gt;Hết giờ: khóa khởi động lại" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="495" y="425" width="510" height="100" as="geometry" /></mxCell><mxCell id="bad-run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#ad3a30;" edge="1" parent="1" source="run" target="fault"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="450" as="sourcePoint" /><mxPoint x="1215" y="650" as="targetPoint" /></mxGeometry></mxCell><mxCell id="bad-run-label" value="DHT lỗi / dữ liệu cũ&lt;br&gt;Lệnh sai / lỗi PWM" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="1035" y="505" width="360" height="105" as="geometry" /></mxCell><mxCell id="fault-stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#ad3a30;" edge="1" parent="1" source="fault" target="stop"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="720" as="sourcePoint" /><mxPoint x="285" y="450" as="targetPoint" /><Array as="points"><mxPoint x="285" y="720" /></Array></mxGeometry></mxCell><mxCell id="fault-stop-label" value="LỖI → DỪNG ngay sau khi tắt tải&lt;br&gt;Khóa khởi động lại; bỏ yêu cầu ON cùng đợt" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="400" y="635" width="590" height="80" as="geometry" /></mxCell><mxCell id="bad-stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;strokeColor=#ad3a30;" edge="1" parent="1" source="stop" target="fault"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="365" as="sourcePoint" /><mxPoint x="1215" y="790" as="targetPoint" /><Array as="points"><mxPoint x="35" y="365" /><mxPoint x="35" y="840" /><mxPoint x="1215" y="840" /></Array></mxGeometry></mxCell><mxCell id="bad-stop-label" value="Lệnh sai khi đang DỪNG cũng ghi nhận LỖI" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="410" y="800" width="570" height="65" as="geometry" /></mxCell><mxCell id="reset-note" value="RESET chỉ mở khóa khi DỪNG và đủ điều kiện.&lt;br&gt;Sau đó phải gửi ON mới; không tự bật lại." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="535" y="115" width="855" height="75" as="geometry" /></mxCell><mxCell id="priority" value="Ưu tiên: LỖI &amp;gt; hết giờ &amp;gt; OFF &amp;gt; RESET &amp;gt; ON" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#23364b;" vertex="1" parent="1"><mxGeometry x="120" y="880" width="1260" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>